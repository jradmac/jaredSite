# Frontend (Vite) environment variables.
# Set these in your hosting provider's dashboard (Vercel/Netlify/etc.),
# then redeploy. Vite only exposes vars prefixed with VITE_.

# Base URL of the backend API (the Express/Prisma server in /server).
VITE_API_BASE_URL=https://your-api-host.example.com

# Meta (Facebook) Pixel ID — find it in Meta Events Manager > Data sources.
# Leave blank to disable Pixel tracking entirely.
VITE_META_PIXEL_ID=
