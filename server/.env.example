# Postgres — Railway injects DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random string. Generate with: openssl rand -hex 64
JWT_SECRET="replace-me"

# Admin login. On first boot, seed.ts hashes this and writes to DB.
ADMIN_USERNAME="jared"
ADMIN_PASSWORD="change-me-after-deploy"

# Stripe (start with test keys: sk_test_... / whsec_...)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Public origin of the React site (for Checkout success/cancel URLs and CORS).
PUBLIC_WEB_ORIGIN="http://localhost:5173"

# Allowed CORS origins (comma-separated). Include prod + local.
CORS_ORIGINS="http://localhost:5173"

# Node env
NODE_ENV="development"
PORT="4000"

# Cookie domain — leave blank for localhost; set to your apex (e.g. "jaredmackay.com") for prod
COOKIE_DOMAIN=""
